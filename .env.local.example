# =============================================================
# Trip Planner — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================

# ---- Supabase ----
# Found in: Supabase dashboard → Project Settings → API

# Safe to expose to the browser (protected by Row-Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-side only — NEVER prefix with NEXT_PUBLIC_
# Bypasses RLS; use only in trusted server-side operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- Anthropic ----
# Server-side only — NEVER prefix with NEXT_PUBLIC_
# Found in: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ---- Optional: Auth redirect URL ----
# Used by Supabase Auth to redirect after email confirmation.
# Set to your production URL in Vercel env vars.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Keep-alive cron (production only) ----
# Vercel Cron sends this as a Bearer token to /api/keepalive, which runs one
# tiny query a day so the free Supabase project is never paused for inactivity.
# Any long random string, e.g. `openssl rand -hex 32`. Server-side only.
CRON_SECRET=
